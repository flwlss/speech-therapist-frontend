# Адрес сайта без слэша в конце. От него зависят sitemap, canonical,
# Open Graph и микроразметка. Укажите настоящий домен.
NEXT_PUBLIC_SITE_URL=

# Telegram-бот для заявок
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Адрес Cloudflare Worker, который пересылает запросы в Telegram
# (нужен, если api.telegram.org недоступен из Яндекс.Облака).
# Без слэша в конце. Если не задан, используется https://api.telegram.org
TELEGRAM_API_BASE=

# Ключи для yc-next-cli
YC_FOLDER_ID=
YC_STORAGE_ACCESS_KEY=
YC_STORAGE_SECRET_KEY=